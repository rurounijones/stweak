# frozen_string_literal: true

source 'https://rubygems.org'

# The data generator is a self-contained application that drives the domain:
# it wires the real adapters (which live in the shared app/adapters area) and
# produces plausible events in volume. It depends on the domain gem and
# declares the technology gems its chosen adapters need.
gem 'stweak', path: '../../..'

gem 'aws-sdk-dynamodb', require: false
gem 'aws-sdk-sqs', require: false
gem 'bcrypt', require: false
gem 'faker', require: false
gem 'redis', require: false
gem 'sqlite3', require: false

group :development, :test do
  gem 'rspec', '~> 3.13', require: false
  gem 'simplecov', '~> 0.22', require: false
  gem 'simplecov-lcov', '~> 0.8', require: false
end
