#!/usr/bin/env ruby
# frozen_string_literal: true

# Generate a continuous account lifecycle trace: each worker creates an
# account, disables it, then deletes it, and repeats until Ctrl-C or TERM.
# Adapter selection and connection settings come from the shared drivers .env
# (see ../../.env.example); dotenv only populates ENV, which the wiring reads
# with ENV.fetch. Usage: stweak-generate [threads] [--check-web-admin]

require 'dotenv'
Dotenv.load(File.expand_path('../../.env', __dir__))

# Enable OpenTelemetry tracing only when an OTLP endpoint is configured (in the
# shared .env). Unset means no exporter and no connection attempts, so the
# generator runs identically with tracing off. use_all auto-instruments the AWS
# SDK (DynamoDB, SQS), Redis, and — for the web-admin checker — Net::HTTP.
# Net::HTTP must be loaded before configure so use_all's net_http
# instrumentation registers its middleware ahead of the checker's requests,
# the same ordering the Redis and Sinatra comments in the other bundles rely
# on.
tracing = !ENV.fetch('OTEL_EXPORTER_OTLP_ENDPOINT', '').empty?
if tracing
  require 'opentelemetry/sdk'
  require 'opentelemetry/exporter/otlp'
  require 'opentelemetry/instrumentation/all'
  require 'redis'
  require 'net/http'
  # Register app instrumentation before use_all, so it installs alongside the
  # off-the-shelf libraries (SQLite has no published gem of its own).
  require_relative '../../../adapters/observability/sqlite_instrumentation'
  require_relative '../../../observability/domain'
  require_relative '../../../observability/adapters'
  OpenTelemetry::SDK.configure do |c|
    c.service_name = 'stweak-data-generator'
    c.use_all
  end
  # On recent aws-sdk-core the instrumentation defers to the SDK's own telemetry
  # plugin, which stays a no-op until a provider is set. Point it at
  # OpenTelemetry so the DynamoDB and SQS client spans are emitted, nesting
  # under the named adapter spans below. Clients built by the wiring inherit it.
  Aws.config[:telemetry_provider] = Aws::Telemetry::OTelProvider.new
  App::Observability::Domain.install
  App::Observability::Adapters.install
end

require_relative '../lib/wiring'

check_web_admin = ARGV.delete('--check-web-admin')
thread_count = Integer(ARGV.fetch(0, DataGenerator::LifecycleGenerator::DEFAULT_THREADS.to_s))
raise ArgumentError, 'thread count must be positive' unless thread_count.positive?

# Wiring constructs the stores, which create their DynamoDB tables and SQS queue
# on first use. Those setup calls happen before any command span, so wrap them
# in one span to keep them from surfacing as orphaned client spans.
build = -> { DataGenerator::Wiring.build }
built =
  if tracing
    OpenTelemetry.tracer_provider
                 .tracer('stweak-data-generator')
                 .in_span('data_generator.boot', attributes: { 'code.function' => 'main#build' }) { build.call }
  else
    build.call
  end

# A signal asks the workers to stop where they are; the ensure block below then
# drains the read side and flushes the traces before the process exits.
stop = proc { built.lifecycle_generator.stop }
Signal.trap('INT', &stop)
Signal.trap('TERM', &stop)

begin
  built.lifecycle_generator.run(
    thread_count: thread_count, check_web_admin: !check_web_admin.nil?
  )
ensure
  built.lifecycle_generator.stop
  # The subscription delivers to the projections asynchronously through its
  # transport, so without draining the process would exit with the tail-end
  # events still unconsumed — their projection work never done and, with
  # tracing on, their spans never recorded. The in-memory subscription
  # delivers synchronously and has nothing to drain.
  built.subscription.drain if built.subscription.respond_to?(:drain)
  # Flush the batch span processor before this short-lived process exits, so
  # the last spans are not dropped.
  OpenTelemetry.tracer_provider.shutdown if tracing
end

puts "Stopped #{thread_count} lifecycle worker(s)"
