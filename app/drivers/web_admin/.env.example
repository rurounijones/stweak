# web_admin adapter selection.
#
# Copy to .env and edit. Each store is chosen independently. The two encrypting
# decorators share one key store, so switch the stores as a COHERENT SET:
#   - all real  (dynamodb + sqlite + redis) reads the data_generator's output.
#   - all memory                            starts empty (a swap demonstration).
# Mixing them is legal but incoherent: real events with a memory projection
# store shows readable events but an empty accounts list, and a memory key store
# against real ciphertext decrypts every name to "erased".

EVENT_STORE=dynamodb        # dynamodb | memory
PROJECTION_STORE=sqlite     # sqlite   | memory
KEY_STORE=redis             # redis    | memory

# Real-adapter settings (ignored by the memory adapters).
STWEAK_DB=stweak.db
STWEAK_STREAMS_TABLE=stweak_streams
AWS_ENDPOINT_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

# The port the web app listens on.
PORT=4567
