<h1 class="text-2xl font-semibold mb-1">Accounts</h1>
<p class="text-slate-500 mb-6"><%= @accounts.length %> account<%= '' if @accounts.length == 1 %><%= 's' unless @accounts.length == 1 %></p>

<% if @accounts.empty? %>
  <div class="rounded-lg border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
    No accounts to show. If you selected the memory adapters they start empty;
    point <code class="text-slate-700">.env</code> at the real stores to read
    the generated data.
  </div>
<% else %>
  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-slate-500">
        <tr>
          <th class="px-4 py-3 font-medium">Username</th>
          <th class="px-4 py-3 font-medium">Display name</th>
          <th class="px-4 py-3 font-medium">Email</th>
          <th class="px-4 py-3 font-medium">Created</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @accounts.each do |account| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-900"><%= account[:username] %></td>
            <td class="px-4 py-3"><%= display(account[:name]) %></td>
            <td class="px-4 py-3 text-slate-600"><%= display(account[:email]) %></td>
            <td class="px-4 py-3 text-slate-500"><%= account[:created_at] %></td>
            <td class="px-4 py-3 text-right">
              <a href="/accounts/<%= account[:account_id] %>" class="text-indigo-600 hover:text-indigo-800 font-medium">View →</a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
