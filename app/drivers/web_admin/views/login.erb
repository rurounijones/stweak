<div class="mx-auto max-w-md">
  <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="mb-1 text-2xl font-semibold text-slate-900">Sign in</h1>
    <p class="mb-6 text-slate-500">Use your stweak account credentials.</p>

    <% if @error %>
      <p class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"><%= @error %></p>
    <% end %>

    <form action="/login" method="post" class="space-y-4">
      <div>
        <label for="username" class="mb-1 block text-sm font-medium text-slate-700">Username</label>
        <input id="username" name="username" type="text" value="<%= @username %>" required autofocus
               class="w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm">
      </div>
      <div>
        <label for="password" class="mb-1 block text-sm font-medium text-slate-700">Password</label>
        <input id="password" name="password" type="password" required
               class="w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm">
      </div>
      <button type="submit" class="w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700">
        Sign in
      </button>
    </form>
  </section>
</div>
