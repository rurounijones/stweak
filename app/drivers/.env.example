# Shared driver configuration.
#
# Copy to .env in this directory; every driver here loads it through dotenv, so
# one file drives them all and the whole system can be exercised end to end
# under one set of adapters. dotenv does not overwrite variables already in the
# environment, so the dev container's service endpoints (set in
# docker-compose) win over the localhost defaults below.
#
# Each store is chosen independently, but switch them as a COHERENT SET:
#   - all real   (dynamodb + elasticmq + sqlite + redis) drives the real stack.
#   - all memory                                         runs entirely in memory.
# Mixing them is legal but incoherent: real events with a memory projection
# store shows readable events but an empty accounts list, and a memory key store
# against real ciphertext decrypts every name to "erased".

# Adapter selection.
EVENT_STORE=dynamodb        # dynamodb | memory   (data_generator, web_admin)
PROJECTION_STORE=sqlite     # sqlite   | memory   (data_generator, web_admin)
KEY_STORE=redis             # redis    | memory   (data_generator, web_admin)
SUBSCRIPTION=elasticmq      # elasticmq | memory  (data_generator, write side)
CHECKPOINT_STORE=redis      # redis    | memory   (data_generator, write side)

# Real-adapter settings (ignored by the memory adapters).
STWEAK_DB=stweak.db
STWEAK_STREAMS_TABLE=stweak_streams
STWEAK_QUEUE=stweak-events
AWS_ENDPOINT_URL=http://localhost:8000
ELASTICMQ_URL=http://localhost:9324
REDIS_URL=redis://localhost:6379

# web_admin only: the port the web app listens on.
PORT=4567

# Tracing. Uncomment to emit OpenTelemetry traces to the OpenObserve container;
# leaving the endpoint unset disables tracing entirely, so the specs and a plain
# run never touch it. The dev container reaches OpenObserve by its compose
# service name. The header is HTTP Basic auth for the container's default root
# user (base64 of root@example.com:Root123!); %20 is the required encoded space.
# The exporter appends /v1/traces to the endpoint. The database semantic
# convention makes DynamoDB spans appear as Datastore services in OpenObserve.
# OTEL_SEMCONV_STABILITY_OPT_IN=database
# OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cm9vdEBleGFtcGxlLmNvbTpSb290MTIzIQ==
