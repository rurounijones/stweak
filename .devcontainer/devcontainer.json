{
  "name": "stweak",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/stweak",
  "remoteEnv": {
    "BUNDLE_PATH": "/usr/local/bundle"
  },
  "postCreateCommand": "git config --global --add safe.directory /workspaces/stweak && bundle install && (cd app/adapters && bundle install) && (cd app/drivers/data_generator && bundle install) && lefthook install",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "sorbet.sorbet-vscode-extension",
        "DavidAnson.vscode-markdownlint",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "rubyLsp.formatter": "rubocop"
      }
    }
  }
}
