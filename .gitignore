# Bundler
/.bundle/
/vendor/bundle/
Gemfile.lock
# The drivers are applications, not libraries, so their lockfiles are committed
# to pin the exact gems a driver runs with; the gem and adapters stay unlocked.
!/app/drivers/*/Gemfile.lock

# Test and coverage output
/coverage/
/spec/reports/
/tmp/
/app/**/coverage/

# Mutant session results
/.mutant/

# Generated documentation
/doc/
/.yardoc/

# MkDocs build output
/site/

# Python bytecode from the MkDocs hooks
__pycache__/

# Sorbet caches and generated RBIs. Shims are hand written and kept.
/sorbet/rbi/gems/
/sorbet/rbi/dsl/
/sorbet/rbi/annotations/
/sorbet/cache/

# Editors and OS
.DS_Store
*.swp

# SQLite files created by the data generator
*.db

# Local driver environment files (adapter selection, tracing); .env.example kept
.env
